# @firebase/rules-unit-testing@4.0.1 declares a peer of firebase@^11.0.0, but its
# runtime code actually needs firebase@12's API (firebase@11 breaks
# RulesTestContext.firestore() at runtime) - a stale peer range in that package,
# not a real incompatibility with firebase@^12 here. `npm ci` validates peers
# strictly and fails on this; legacy-peer-deps skips that check.
legacy-peer-deps=true
